APP_NAME=ainza-restaurant-ai-backend
APP_ENV=local
DEBUG=true
DATABASE_URL=postgresql+asyncpg://ainza:ainza_local_password@localhost:5432/ainza
FRONTEND_ORIGINS=["http://localhost:3000"]

# ── Primary LLM provider (llama.cpp local OR any OpenAI-compat remote endpoint) ──
# For Gemini via Google's OpenAI-compat shim:
#   LOCAL_LLM_RUNTIME_MODE=remote
#   LOCAL_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LOCAL_LLM_MODEL=gemini-2.0-flash-lite
#   LOCAL_LLM_API_KEY=<your-gemini-api-key>
# For local llama.cpp:
#   LOCAL_LLM_RUNTIME_MODE=local
#   LOCAL_LLM_BASE_URL=http://127.0.0.1:8081/v1
#   LOCAL_LLM_MODEL=ainza-qwen3-8b
LOCAL_LLM_RUNTIME_MODE=remote
LOCAL_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LOCAL_LLM_MODEL=gemini-2.0-flash-lite
LOCAL_LLM_API_KEY=
LOCAL_LLM_CONNECT_TIMEOUT_SECONDS=10
LOCAL_LLM_TIMEOUT_SECONDS=60
LOCAL_LLM_MAX_TOKENS=512
LOCAL_LLM_MAX_TOOL_ROUNDS=6
LOCAL_LLM_CONTEXT_TURNS=12

# ── Cloudflare Workers AI fallback ──────────────────────────────────────────────
# Leave blank to disable. When set, Cloudflare is used automatically if the
# primary provider times out or becomes unavailable.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_TIMEOUT_SECONDS=60
CLOUDFLARE_MAX_TOKENS=512

# ── Provider selection ────────────────────────────────────────────────────────
# "auto"       → LOCAL_LLM_BASE_URL is primary; Cloudflare fallback if creds set
# "cloudflare" → Cloudflare is primary; LOCAL_LLM_BASE_URL is fallback
AI_PRIMARY_PROVIDER=auto

AI_CONFIRMATION_TTL_MINUTES=15

# ── Speech-to-text (whisper.cpp — unchanged) ──────────────────────────────────
LOCAL_STT_BASE_URL=http://127.0.0.1:8082
LOCAL_STT_TIMEOUT_SECONDS=180
LOCAL_STT_MAX_AUDIO_BYTES=8388608
LOCAL_STT_MAX_AUDIO_SECONDS=30
LOCAL_STT_MAX_CONCURRENT_REQUESTS=1
LOCAL_STT_LANGUAGE=auto
